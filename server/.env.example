# Copy to .env — never commit real values.
PORT=4000
DATABASE_URL=postgres://groundtruth:groundtruth_dev@localhost:5432/groundtruth
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Phase 1 auth: JWT secret (REQUIRED in production — the server refuses to
# sign tokens without one). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
# JWT lifetime, e.g. 1d, 12h. Default: 1d.
JWT_EXPIRES_IN=1d
# Public base URL of the client — used to build password-reset links.
FRONTEND_URL=http://localhost:3000

# GitHub API token (OPTIONAL): raises the public-repo analysis rate limit
# from 60 to 5,000 requests/hour. Only the user can create one (GitHub
# Settings > Developer settings > Personal access tokens); the server never
# needs it for public repos and private repos are still refused.
GITHUB_API_TOKEN=

# LLM (OpenAI-compatible chat completions) — see src/services/llm.ts.
# All optional. When base URL / key / model are missing (or AI_MOCK=true),
# the server uses the deterministic mock provider and never calls a live model.
# No model name is hardcoded; set AI_MODEL explicitly. Never commit real keys.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000
AI_MOCK=false
AI_RATE_LIMIT_PER_MIN=30
AI_TIMEOUT_MS=30000

# Code-execution sandbox: unshare = Linux user+net+mount+pid namespaces;
# disabled = fail closed, code is never run unsandboxed.
EXECUTION_SANDBOX=unshare
# Hard wall-clock limit (seconds) per execution run.
EXECUTION_TIMEOUT_SECONDS=30
# Retention for raw monitoring event rows (days).
MONITORING_RETENTION_DAYS=90
