# Copy to .env — never commit real values.
PORT=4000
DATABASE_URL=postgres://groundtruth:groundtruth_dev@localhost:5432/groundtruth
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Phase 1 auth: JWT secret (REQUIRED in production — the server refuses to
# sign tokens without one). Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
# JWT lifetime, e.g. 1d, 12h. Default: 1d.
JWT_EXPIRES_IN=1d
# Public base URL of the client — used to build password-reset links.
FRONTEND_URL=http://localhost:3000
