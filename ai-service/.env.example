# Copy to .env — never commit real values.
AI_SERVICE_PORT=8000
DATABASE_URL=postgres://groundtruth:groundtruth_dev@localhost:5432/groundtruth
# Optional in Phase 0. If unset, embeddings use the deterministic local-hash
# dev fallback (model="local-hash-dev-only") — NOT for production matching.
OPENAI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated origins allowed to call this service from a browser.
CORS_ORIGINS=http://localhost:3000

# ── AI assessment system (Phase 1+) ──
# The assessment LLM client lives in the Express server
# (server/src/services/llm.ts), not in ai-service. These vars are listed
# here only so a deploy that runs ai-service alongside the server keeps one
# consistent set; ai-service itself does not call the LLM.
AI_API_BASE_URL=
AI_API_KEY=<redacted>
AI_MODEL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000
AI_MOCK=false
