# Copy to .env — never commit real values.
AI_SERVICE_PORT=8000
DATABASE_URL=postgres://groundtruth:groundtruth_dev@localhost:5432/groundtruth
# Optional in Phase 0. If unset, embeddings use the deterministic local-hash
# dev fallback (model="local-hash-dev-only") — NOT for production matching.
OPENAI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated origins allowed to call this service from a browser.
CORS_ORIGINS=http://localhost:3000
