# ── Root env example — copy to .env and fill in real values. Never commit .env. ──

# Postgres (docker-compose service "postgres")
DATABASE_URL=postgres://groundtruth:groundtruth_dev@localhost:5432/groundtruth
POSTGRES_USER=groundtruth
POSTGRES_PASSWORD=groundtruth_dev
POSTGRES_DB=groundtruth

# Redis (docker-compose service "redis")
REDIS_URL=redis://localhost:6379

# Cloudinary — get from https://cloudinary.com/console (no defaults, never hardcode)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI — optional in Phase 0. If unset, ai-service uses the deterministic
# local-hash dev fallback (model="local-hash-dev-only", NOT for production).
OPENAI_API_KEY=

# Service URLs
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Ports
PORT=4000
AI_SERVICE_PORT=8000
CLIENT_PORT=3000

# Auth placeholder (Phase 0 only has an API-key placeholder check)
JWT_SECRET=change-me-in-production
API_KEY=dev-api-key-change-me

# LLM (OpenAI-compatible chat completions) — see server/src/services/llm.ts.
# Optional: unset (or AI_MOCK=true) means the deterministic mock provider.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000
AI_MOCK=false
AI_RATE_LIMIT_PER_MIN=30
AI_TIMEOUT_MS=30000

# Code-execution sandbox: unshare = Linux user+net+mount+pid namespaces
# (verified working in this VM; Docker is NOT required or used).
# disabled = fail closed — code is never run unsandboxed.
EXECUTION_SANDBOX=unshare
# Hard wall-clock limit (seconds) per execution run.
EXECUTION_TIMEOUT_SECONDS=30
# Retention for raw monitoring event rows (days); verdicts and evaluation
# summaries are never purged.
MONITORING_RETENTION_DAYS=90
